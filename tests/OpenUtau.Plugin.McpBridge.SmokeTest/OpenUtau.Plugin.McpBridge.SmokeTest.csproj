<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenUtau.Plugin.McpBridge.SmokeTest</AssemblyName>
    <RootNamespace>OpenUtau.Plugin.McpBridge.SmokeTest</RootNamespace>
    <OpenUtauCoreDir>$([System.IO.Path]::GetDirectoryName('$(OpenUtauCorePath)'))</OpenUtauCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenUtau.Plugin.McpBridge\OpenUtau.Plugin.McpBridge.csproj" />
    <Reference Include="OpenUtau.Core">
      <HintPath>$(OpenUtauCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The host ships Core next to its own dependencies. Copy that directory into a
       subfolder (never the output root: the host folder may also contain a bundled
       runtime, which would shadow the SDK's) and resolve it from there at run time. -->
  <ItemGroup>
    <OpenUtauRuntimeDependency Include="$(OpenUtauCoreDir)\*.dll" Exclude="$(OpenUtauCorePath)" />
  </ItemGroup>

  <Target Name="CopyOpenUtauRuntimeDependencies" AfterTargets="Build">
    <Copy SourceFiles="@(OpenUtauRuntimeDependency)"
          DestinationFolder="$(OutDir)openutau"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
